  "keyFeatures": [
    "Multi-agent LLM orchestration with planner + worker architecture",
    "Dual-graph system: global Asset Graph + per-task Exploration Graph",
    "MITM traffic recording proxy for full request/response capture",
    "Tool intercept/approval gate for human-in-the-loop oversight",
    "Cross-worker process-level information exchange via trace search",
    "Persistent planner todolist enabling stable multi-step attack chains",
    "Vulnerability retest agent for automated fix verification",
    "MCP (Model Context Protocol) integration for external tools",
    "Skill system for reusable instruction packages",
    "ScopeSentry asset sync for importing external reconnaissance data",
    "IM notification push (DingTalk, Feishu, Telegram, email, webhooks)",
    "Self-update mechanism with rollback support",
    "Single-binary deployment with embedded Next.js frontend"
  ],
  "publicApiSurface": [
    "GET /api/tasks — list tasks",
    "POST /api/tasks — create task",
    "POST /api/tasks/{id}/control — start/stop/pause task",
    "GET /api/exploration/findings — list vulnerability findings",
    "GET /api/exploration/findings/{id} — get finding detail",
    "GET /api/assets — list assets",
    "POST /api/assets — insert assets",
    "GET /api/companies — list companies",
    "POST /api/companies — create company",
    "GET /api/intercept/pending — list pending intercept approvals",
    "POST /api/intercept/pending/{id}/decide — approve/deny intercept",
    "GET /api/llm/profiles — list LLM profiles",
    "POST /api/llm/profiles — save LLM profile",
    "GET /api/agents — list agents",
    "GET /api/skills — list skills",
    "POST /api/mcp — save MCP server config",
    "GET /api/traffic — list traffic records",
    "POST /api/sync/scopesentry/sync — sync assets from ScopeSentry",
    "GET /api/update/check — check for updates",
    "POST /api/update/apply — apply update",
    "GET /api/stats — system statistics",
    "GET /api/logs/stream — SSE log stream"
  ]
}
